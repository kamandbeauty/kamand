<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Diary" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Diary.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Sized so the whole figure clears the circular mask the system
             applies: artwork must fit a 192dp circle on a 288dp canvas. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_koala</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Diary</item>
    </style>
</resources>
