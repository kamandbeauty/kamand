<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom content area for the reminder notification.

  Apps targeting Android 12+ cannot post a fully custom notification: the system
  wraps this view in its own template, which supplies the app icon, the app name
  and the expand chevron. Only the area below that header belongs to us, so this
  layout carries no icon of its own — the badge that used to sit here simply
  duplicated the icon the system already draws a few pixels to its left.

  The gradient fills edge to edge with no outer margin, so the coloured area
  covers the whole content region the template allows rather than floating as a
  pill inside it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/notification_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:textSize="14sp"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#59000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_medium"
            android:textSize="12sp"
            android:textColor="#E0FFFFFF"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:background="@drawable/notification_action"
        android:fontFamily="@font/vazirmatn_semibold"
        android:textSize="12sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2" />
</LinearLayout>
