<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom reminder notification.

  A plain notification inherits the system's grey styling; this one carries the
  ROOZI gradient, a large clock badge and Vazirmatn text so a reminder is
  instantly recognisable in a crowded shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/notification_background"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Large clock badge -->
    <TextView
        android:id="@+id/notif_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="⏰"
        android:textSize="27sp"
        android:background="@drawable/notification_icon_badge" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:shadowColor="#73000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/vazirmatn_medium"
            android:textSize="13sp"
            android:textColor="#EAFFFFFF"
            android:shadowColor="#59000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/notification_action"
        android:fontFamily="@font/vazirmatn_semibold"
        android:textSize="13sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#59000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3" />
</LinearLayout>
