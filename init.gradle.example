// ============================================================
// نمونه فایل init.gradle برای کاربران ایران
//
// روش استفاده:
//   این فایل را کپی کنید و در یکی از مسیرهای زیر بگذارید:
//     - Linux/macOS : ~/.gradle/init.gradle
//     - Windows     : %USERPROFILE%\.gradle\init.gradle
//
// سپس یک Repository آینه‌ای (که از داخل ایران در دسترس است)
// به‌عنوان منبع اول وابستگی‌ها اضافه می‌شود. در صورت نبودِ یک
// mirror مشخص، فقط همین فایل را با mirror موردنظرتان کامل کنید
// یا به‌طور کلی حذفش کنید تا از مخزن‌های پیش‌فرض استفاده شود.
// ============================================================

allprojects {
    repositories {
        // مثال — جایگزین کنید با آینه‌ی در دسترس خودتان:
        // maven { url = uri("https://your-mirror.example.com/repository/google") }
        // maven { url = uri("https://your-mirror.example.com/repository/maven") }
    }
}
