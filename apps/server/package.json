{
  "name": "@javid/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/src/main.js",
    "dev": "node --experimental-sqlite --watch dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --experimental-sqlite --test dist/test/*.test.js"
  },
  "dependencies": {
    "@javid/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
