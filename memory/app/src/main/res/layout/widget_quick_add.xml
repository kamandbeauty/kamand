<?xml version="1.0" encoding="utf-8"?>
<!-- Compact "add a task" launcher. Fully coloured, since it has no content
     of its own to keep legible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_quick_add_background"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="+"
        android:textSize="21sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="@font/vazirmatn_medium"
        android:background="@drawable/widget_add_button" />

    <TextView
        android:id="@+id/quick_add_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/vazirmatn_semibold"
        android:textSize="14sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#59000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4" />
</LinearLayout>
