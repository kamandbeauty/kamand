{
    "name": "havato/havato",
    "description": "Enterprise WordPress Plugin for Cafe Social Networking and Event Matching",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Havato Team",
            "email": "dev@havato.app"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/installers": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Havato\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": false
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"echo 'PSR-4 autoloader ready.\\n';\""
        ]
    }
}