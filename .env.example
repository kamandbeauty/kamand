# Local/CI release signing variable names only.
# Copy to .env for local use, fill with your own values, and never commit .env.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# CI only: Base64 contents of the private keystore file.
# GitHub Actions reads this as the RELEASE_KEYSTORE_BASE64 secret.
RELEASE_KEYSTORE_BASE64=
