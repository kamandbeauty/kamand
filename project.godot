; Engine configuration file.
; Hyper-Casual 3D Android foundation
config_version=5

[application]
config/name="Kamand Arcade Shooter"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

autoload/GameManager="*res://scripts/systems/GameManager.gd"
autoload/LevelManager="*res://scripts/level/LevelManager.gd"
autoload/PlayerManager="*res://scripts/systems/PlayerManager.gd"
autoload/EnemyManager="*res://scripts/enemy/EnemyManager.gd"
autoload/GateManager="*res://scripts/gates/GateManager.gd"
autoload/AudioManager="*res://scripts/systems/AudioManager.gd"
autoload/SaveManager="*res://scripts/systems/SaveManager.gd"
autoload/UIManager="*res://scripts/ui/UIManager.gd"

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
shoot={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
